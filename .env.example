# === Application ===
APP_NAME=bajus-price-api
APP_ENV=development
DEBUG=true
API_VERSION=v1
HOST=0.0.0.0
PORT=8000

# === Database (PostgreSQL) ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=priceapi
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=bajus_prices

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# === Scraper ===
SCRAPE_INTERVAL_MINUTES=10
SCRAPE_SOURCE_URL=https://bajushub.com/
PRICE_CHANGE_THRESHOLD_PCT=15
STALE_CACHE_MINUTES=60
MAX_CONSECUTIVE_FAILURES=3

# === API Key Settings ===
API_KEY_PREFIX=gsp_live_
ADMIN_SECRET=change_me_admin_secret

# === Rate Limiting ===
RATE_LIMIT_FREE_PER_MINUTE=5
RATE_LIMIT_STARTER_PER_MINUTE=20
RATE_LIMIT_PRO_PER_MINUTE=60
RATE_LIMIT_ENTERPRISE_PER_MINUTE=120

# === Plan Quotas (monthly) ===
# free=200, starter=10000 ($6/mo), pro=100000, enterprise=1000000
QUOTA_FREE=200
QUOTA_STARTER=10000
QUOTA_PRO=100000
QUOTA_ENTERPRISE=1000000

# === Alerts ===
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# === Stripe (for billing) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from your Stripe Dashboard (Products → Prices)
STRIPE_MONTHLY_PRICE_ID=   # $6/month — e.g. price_1ABC...
STRIPE_ANNUAL_PRICE_ID=    # $60/year  — e.g. price_1XYZ...
